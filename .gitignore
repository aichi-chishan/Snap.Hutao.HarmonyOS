# ============================================================
# Snap.Hutao.HarmonyOS — 忽略规则
# 原则：构建产物 / 本地配置 / 含隐私或密钥的文件一律不入库。
# 新增忽略项时请归入对应分组，不要散落。
# ============================================================

# ===== 构建产物 =====
/node_modules
/oh_modules
**/build
/.hvigor
/.cxx
/.appanalyzer
**/.test
/.cache

# ===== 本地签名配置（含密钥，自行在 DevEco 配置）=====
/build-profile.json5
/local.properties

# ===== IDE / 编辑器 =====
/.idea
/.deveco
*.iml
.DS_Store
Thumbs.db

# ===== AI 工具与本地开发辅助（非项目源码）=====
/.zcode
/.mimocode
/.mimosa/
/.agents/
/.claude/
/spec/
/skills

# ===== 独立数据仓库（snap-hutao-data，另行托管）=====
/github-data

# ===== 参考截图（Windows 版界面截图；含账号信息，不公开）=====
/example

# ===== 隐私/调试产物：截图与布局转储 =====
/.debug/
/.local/
shot_*.jpeg
shot_*.png
layout*.json

# ===== 临时文件 / 备份 =====
.tmp_*
*.bak
*.orig
*.log
ci_lint_log.txt
